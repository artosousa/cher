---
import Layout from "../layouts/Layout.astro";
import { Image } from 'astro:assets';
import Logo from '../images/logo.svg'
---

<Layout title="Add Task">
  <div class="w-full flex flex-col items-center justify-center">
    <div class="w-full max-w-[90vw] lg:max-w-[65vw] flex flex-col h-[100%] items-center justify-center">
      <header class="flex flex-row w-full justify-between items-center border-b-1 border-[#003246] pb-2 mb-8 lg:mb-16">
        <Image class="w-[200px]" src={Logo} alt="Cherlist" aria-label="Cherlist logo" />
        <div class="flex flex-row">
          <form class="" action="/api/auth/signout" method="GET">
            <button class="w-full mt-4 mb-4 rounded-md bg-gray-300 text-gray-700  p-3 text-l cursor-pointer hover:bg-[#999]" type="submit">Sign out</button>
          </form>
        </div>
      </header>
    </div>
    <div class="flex flex-col items-center justify-center">
      <div class="bg-white w-full max-w-[90%]  shadow-md flex flex-col items-center rounded-md p-8">
        <h1 class="w-full text-lg font-bold text-[#003246] border-b-1 border-[#003246] pb-2 mb-4">Add a Task</h1>
        <form id="addTaskForm" enctype="multipart/form-data">
          <input autofocus placeholder="Task Name" class="p-2 focus:outline-0 w-full border-b-[#003246] border-b-1 mb-4" type="text" name="task" id="task" required />

          <!-- Submit button -->
          <button class="w-full mt-4 mb-4 rounded-md bg-[#003246] text-white p-3 text-l cursor-pointer hover:bg-[#095870] "  type="submit">Add Task</button>
        </form>
      </div>
    </div>
  </div>
  
  
</Layout>

<script>
  // Define the structure of task data
  interface TaskData {
    task: string;
  }
  const taskInput = document.getElementById('task')
  console.log(taskInput)
  document.addEventListener("DOMContentLoaded", () => {
    taskInput?.focus()
  })
  
  // Function to handle adding a new task
  const addTask = async (taskData: TaskData) => {
    // Retrieve the Firebase token from local storage (assumed to be stored after login)
    const idToken = localStorage.getItem("idToken");

    if (!idToken) {
      alert("User is not authenticated");
      return;
    }

    // Create FormData to handle multipart form submission
    const formData = new FormData();
    formData.append("task", taskData.task);

    try {
      // Send the form data to the backend API (previously implemented)
      const response = await fetch("/api/tasks", {
        method: "POST",
        headers: {
          Authorization: `Bearer ${idToken}`, // Include the auth token
        },
        body: formData, // Pass the FormData as the body
      });

      // Handle response status
      if (!response.ok) {
        const errorText = await response.text();
        console.error("Failed to add task:", errorText);
        alert(`Failed to add task: ${errorText}`);
      } else {
        console.log("Task added successfully!");
        window.location.href = "/dashboard"; // Redirect on success
      }
    } catch (error) {
      console.error("An error occurred:", error);
      alert("Error adding Task, please try again.");
    }
  };

  // TypeScript: Ensure the form element is treated as an HTMLFormElement
  const form = document.getElementById("addTaskForm") as HTMLFormElement;

  if (form) {
    // On form submission, prevent default action and gather data
    form.addEventListener("submit", async (e) => {
      e.preventDefault(); // Prevent form default submission

      const formData = new FormData(form); // Collect form data
      const task = formData.get("task")?.toString();

      if (!task) {
        alert("Task name is required");
        return;
      }

      // Create a TaskData object to send to the addTask function
      const taskData: TaskData = {
        task,
      };

      // Call the addTask function with the task data
      await addTask(taskData);
    });
  }
</script>
