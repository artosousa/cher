---
import { app } from "../firebase/server";
import { getFirestore, Timestamp } from "firebase-admin/firestore"; 
import { getAuth } from "firebase-admin/auth";
import Layout from "../layouts/Layout.astro";
import CalendarComponent from "../components/CalendarComponent.tsx"; 
import { Image } from 'astro:assets';
import Logo from '../images/logo.svg'

interface Task {
  id: string;
  name: string;
  isComplete: boolean;
  completedAt?: Timestamp;
}

const db = getFirestore(app);
const auth = getAuth(app);

let userId: string | undefined;

if (Astro.cookies.has("__session")) {
  const sessionCookie = Astro.cookies.get("__session")?.value ?? "";
  const decodedCookie = await auth.verifySessionCookie(sessionCookie);
  userId = decodedCookie.uid;
}

if (!userId) {
  throw new Error("User not authenticated");
}

const tasksRef = db.collection("users").doc(userId).collection("tasks");
const tasksSnapshot = await tasksRef.get();

const tasks: Task[] = tasksSnapshot.docs.map((doc) => {
  const data = doc.data();
  return {
    id: doc.id,
    name: data.name,
    isComplete: data.isComplete,
    completedAt: data.completedAt instanceof Timestamp ? data.completedAt : null, 
  } as Task;
});

const completedDates = tasks
  .filter((task) => task.isComplete && task.completedAt)
  .map((task) => {
    if (task.completedAt) {
      return task.completedAt.toDate().toLocaleDateString();
    }
    return '';
  })
  .filter((date): date is string => date !== ''); 

// Function to update completed task dates
const updateCompletedDates = async () => {
  const updatedTasksSnapshot = await tasksRef.get();
  const updatedCompletedDates = updatedTasksSnapshot.docs
    .map((doc) => {
      const data = doc.data();
      if (data.isComplete && data.completedAt instanceof Timestamp) {
        return data.completedAt.toDate().toLocaleDateString();
      }
      return '';
    })
    .filter((date): date is string => date !== '');

  return updatedCompletedDates;
};

const uniqueDates = new Set(completedDates)
---

<Layout title="My tasks">
  <div class="w-full flex flex-col items-center justify-center">
    <div class="w-full max-w-[90vw] lg:max-w-[65vw] flex flex-col h-[100%] items-center justify-center">
      <header class="flex flex-row w-full justify-between items-center border-b-1 border-[#003246] pb-2 mb-8 lg:mb-16">
        <Image class="w-[200px]" src={Logo} alt="Cherlist" aria-label="Cherlist logo" />
        <div class="flex flex-row">
         
          <form class="" action="/api/auth/signout" method="GET">
            <button class="w-full mt-4 mb-4 rounded-md bg-gray-300 text-gray-700  p-3 text-l cursor-pointer hover:bg-[#999]" type="submit">Sign out</button>
          </form>
        </div>
      </header>
      <div class="w-full flex flex-col lg:flex-row gap-8 lg:gap-16 justify-center">
        <div class="bg-white lg:min-w-[415px] w-full  shadow-md flex flex-col  rounded-md p-8">
         
          <div class="items-end flex flex-row justify-between border-b-1 border-[#003246] pb-2 mb-4">
             <h1 class="text-lg font-bold text-[#003246] ">My To Do List:</h1>
             <a class=" w-fit text-center rounded-md bg-[#003246] text-white p-3 text-l cursor-pointer hover:bg-[#095870]" href="/add">Add Task</a>
          </div>
          {tasks.length > 0 ? (
            <ul id="task-list">
              {tasks.map((task) => (
                <li class={task.isComplete ? "line-through" : ""}>
                  <input
                    id={task.name?.replace(/\s+/g, '')}
                    type="checkbox"
                    checked={task.isComplete}
                    data-id={task.id}
                    class="task-checkbox"
                    onchange={`updateTaskStatus(event, '${task.id}')`} 
                  />
                  <label for={task.name?.replace(/\s+/g, '')}>
                    {task.name ?? 'Unnamed Task'}
                  </label>
                </li>
              ))}
            </ul>
          ) : (
            <div class="w-full h-[100%] flex flex-col items-center justify-center">
              <p class="mb-4">YOUR LIST IS CURRENTLY EMPTY!</p>
              <a class=" w-[50%] cy text-center rounded-md bg-[#003246] text-white p-3 text-l cursor-pointer hover:bg-[#095870]" href="/add">Add Task</a>
            </div>
          )}
        </div>
        


        <div class="bg-white lg:min-w-[415px] w-full shadow-md flex flex-col items-center  rounded-md p-8 mb-16">
          <div class="w-full flex flex-row justify-between text-lg font-bold text-[#003246] border-b-1 border-[#003246] pb-2 mb-4">
            <h2 class="">Cher Streak:</h2>
            <h3>{uniqueDates.size} Day{uniqueDates.size > 1 ? 's' : ''}</h3>
          </div>
          <CalendarComponent 
            client:load
            completedDates={completedDates} 
            onUpdateCompletedDates={async () => {
              const updatedDates = await updateCompletedDates();
              // Trigger the update in the parent component
              document.dispatchEvent(new CustomEvent('update-completed-dates', { detail: updatedDates }));
            }}
          />
        </div>
      </div>
      

    </div>
    
  </div>
  <script>
    
  // This function will be responsible for updating the task status
  (window as any).updateTaskStatus = async function (event: Event, taskId: string) {
    const target = event.target as HTMLInputElement;
    const isComplete = target.checked;

    const payload = { 
      isComplete,
      completedAt: isComplete ? new Date() : null, 
    };

    try {
      const response = await fetch(`/api/tasks/${taskId}`, {
        method: "PATCH",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(payload),
      });

      if (!response.ok) {
        throw new Error("Failed to update task");
      } else {
        location.reload()
      }
    } catch (error) {
      console.error("Error updating task:", error);
    }
  }

  
  // Attach the onchange event to the task checkboxes dynamically (in case you have many tasks)
  document.addEventListener("DOMContentLoaded", () => {
    const taskList = document.getElementById('task-list')
    taskList?.addEventListener('click', (e) => {
      const taskId = (e.target as HTMLInputElement).getAttribute("data-id");
      if (taskId) {
        (window as any).updateTaskStatus(e, taskId);
      }
    })
  });
</script>


</Layout>
