---
// Import necessary modules
import { app } from "../firebase/server";
import { getAuth } from "firebase-admin/auth";
import Layout from "../layouts/Layout.astro";
import { Image } from 'astro:assets';
import Logo from '../images/logo.svg'
// Check if the user is authenticated
const auth = getAuth(app);
if (Astro.cookies.has("__session")) {
  const sessionCookie = Astro.cookies.get("__session")?.value ?? "";
  const decodedCookie = await auth.verifySessionCookie(sessionCookie);
  if (decodedCookie) {
    return Astro.redirect("/dashboard");
  }
}

---

<Layout title="Sign in">
  <div class="flex flex-col items-center justify-center h-[100vh]">
    <div class="bg-white w-full max-w-[90%] lg:max-w-md  shadow-md flex flex-col items-center rounded-md p-8">
      <Image src={Logo} alt="Cherlist" aria-label="Cherlist logo" />
      <h1 class="text-[#003246] text-md mt-4 mb-4 text-center">Welcome to Cherlist! Stay motivated and productive with a consistency-driven to-do list that helps you build lasting habits.</h1>
      <form id="signin-form" class="flex flex-col w-full text-[#003246] text-sm">
        <fieldset class="mb-4">
          <input placeholder="Email Address" class="p-2 focus:outline-0 w-full border-b-[#003246] border-b-1" type="email" name="email" id="email" required />
        </fieldset>
        <fieldset>
          <input placeholder="Password" class="p-2 focus:outline-0  w-full border-b-[#003246] border-b-1" type="password" name="password" id="password" required />
        </fieldset>
        <button type="submit" class="w-full mt-4 mb-4 rounded-md bg-[#003246] text-white p-3 text-l cursor-pointer hover:bg-[#095870] ">Login</button>
      </form>
      <div class="flex text-gray-400 flex-row w-full items-center justify-center gap-4 before:content-[''] before:border-t-1 before:w-[40%] after:content-[''] after:border-t-1 after:w-[40%] mb-4">or</div>
      <button
        id="google"
        aria-label="Sign in with Google"
        class="flex items-center gap-3 bg-[#1a73e8] rounded-md p-0.5 pr-3 transition-colors duration-300 hover:bg-[#5195ee]"
      >
        <div class="flex items-center justify-center bg-white w-9 h-9 rounded-l">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="w-5 h-5">
            <title>Sign in with Google</title>
            <desc>Google G Logo</desc>
            <path
              d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"
              class="fill-[#4285f4]"
            ></path>
            <path
              d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"
              class="fill-[#34a853]"
            ></path>
            <path
              d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"
              class="fill-[#fbbc05]"
            ></path>
            <path
              d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"
              class="fill-[#ea4335]"
            ></path>
          </svg>
        </div>
        <span class="text-sm text-white tracking-wider">Sign in with Google</span>
      </button>
      <hr class="mt-6 mb-6 w-full "/>
      <p class="text-sm text-[#003246]">New here? <a href="/register" class="underline text-[#003246] hover:text-[#095870]">Create an account</a></p>
    </div>
  </div>
</Layout>

<script>
  console.log(import.meta.env)
  import {
    getAuth,
    inMemoryPersistence,
    signInWithEmailAndPassword,
    GoogleAuthProvider,
    signInWithPopup,
  } from "firebase/auth";
  import { app } from "../firebase/client";

  const auth = getAuth(app);
  auth.setPersistence(inMemoryPersistence);

  // Use type assertion to ensure `form` is treated as HTMLFormElement
  const form = document.getElementById("signin-form") as HTMLFormElement;
  
  form.addEventListener("submit", async (e) => {
    e.preventDefault();
    const formData = new FormData(form);
    const email = formData.get("email")?.toString();
    const password = formData.get("password")?.toString();

    if (!email || !password) {
      return;
    }

    try {
      const userCredential = await signInWithEmailAndPassword(auth, email, password);
      const idToken = await userCredential.user.getIdToken();

      // Store the ID token in local storage
      localStorage.setItem("idToken", idToken); 

      const response = await fetch("/api/auth/signin", {
        headers: {
          Authorization: `Bearer ${idToken}`,
        },
      });

      if (response.redirected) {
        window.location.assign(response.url);
      }
    } catch (error) {
      console.error("Error signing in:", error);
    }
  });

  const googleSignin = document.getElementById("google") as HTMLButtonElement;
  googleSignin.addEventListener("click", async () => {
    const provider = new GoogleAuthProvider();
    const userCredential = await signInWithPopup(auth, provider);
    const idToken = await userCredential.user.getIdToken();

    // Store the ID token in local storage
    localStorage.setItem("idToken", idToken);

    const res = await fetch("/api/auth/signin", {
      headers: {
        Authorization: `Bearer ${idToken}`,
      },
    });

    if (res.redirected) {
      window.location.assign(res.url);
    }
  });
</script>